# Copy this file to .env and fill in real values before `docker compose up`.
# Never commit the real .env — it holds every credential in the stack.
# Every value here gets substituted into docker-compose.yml and re-scanned
# for '$' the same as the file itself — if you generate a password that
# happens to contain a literal '$', double it to '$$' or Compose will read
# the rest as a (nonexistent) variable reference and silently blank it.

# ---- domain -----------------------------------------------------------
# Local (Docker Desktop):  DOMAIN=localhost
#   *.localhost resolves to 127.0.0.1 on its own — no hosts-file edit needed.
#   Use only docker-compose.yml (plain HTTP); skip docker-compose.tls.yml.
# VM with a real domain:   DOMAIN=example.com
#   Point forgejo.example.com, ci.example.com, sonar.example.com,
#   ops.example.com, storage.example.com, storage-console.example.com,
#   grafana.example.com, and traefik.example.com at the VM's IP, open
#   ports 80+443, then run with both compose files (see deploy/README.md).
DOMAIN=localhost

# ACME (Let's Encrypt) — only read when docker-compose.tls.yml is used
ACME_EMAIL=you@example.com

# ---- traefik dashboard basic auth --------------------------------------
# Generate with: htpasswd -nB admin, then double every '$' as '$$'.
# Compose re-scans a substituted ${VAR} value for '$' the same as it scans
# the file itself, so a raw bcrypt hash (which is full of '$') gets mangled
# unless escaped here too — verified with `docker compose config`: doubled
# input resolves to the correct single-'$' label value on the container,
# single input gets misread as more variable references and silently
# blanked. Default below is user "admin" / password "admin" — change this
# before deploying anywhere reachable off your own machine.
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$OoJ0J9y8m8s0S4y3q2b3lOe3l8m8k8k8k8k8k8k8k8k8k8k8k8k8k

# ---- shared postgres (forgejo + sonarqube) -----------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser

FORGEJO_DB_NAME=forgejo
FORGEJO_DB_USER=forgejo
FORGEJO_DB_PASSWORD=change-me-forgejo

SONARQUBE_DB_NAME=sonarqube
SONARQUBE_DB_USER=sonarqube
SONARQUBE_DB_PASSWORD=change-me-sonarqube

# ---- woodpecker ---------------------------------------------------------
# WOODPECKER_AGENT_SECRET / WOODPECKER_GRPC_SECRET: any random string each,
# e.g. `openssl rand -hex 32`. Different purposes (see docs/tools/woodpecker.md
# if you want the distinction) — generate two separate values, don't reuse one.
WOODPECKER_AGENT_SECRET=change-me-agent-secret
WOODPECKER_GRPC_SECRET=change-me-grpc-secret

# Filled in AFTER Forgejo is up: Forgejo -> Settings -> Applications ->
# create an OAuth2 application with redirect URL
# http://ci.<DOMAIN>/authorize (or https:// on a VM). See deploy/README.md
# step 3 for the exact walkthrough.
WOODPECKER_FORGEJO_CLIENT=
WOODPECKER_FORGEJO_SECRET=

# ---- minio ---------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-root

# ---- grafana ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
